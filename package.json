{
  "name": "answerbook-api",
  "version": "1.0.4",
  "private": true,
  "description": "Cloudflare Worker API for Book of Answers, Random Passwords, and Words Learning",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "prepare-words": "node scripts/prepare-words-data.js",
    "upload-words": "node scripts/upload-words-to-kv.js",
    "build-data": "npm run prepare-words && npm run upload-words"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  }
}
