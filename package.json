{
  "name": "answerbook-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker API for Book of Answers, Random Passwords, and Words Learning",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "prepare-words": "node scripts/prepare-words-data.js",
    "upload-words": "node scripts/upload-words-to-kv.js",
    "build-data": "npm run prepare-words && npm run upload-words"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.4.5",
    "vitest": "1.5.0",
    "wrangler": "^4.75.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.0",
    "hono": "^4.11.2",
    "zod": "^4.2.1"
  }
}
